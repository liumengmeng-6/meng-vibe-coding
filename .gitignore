# 环境变量与密钥（重要：数据库密码等敏感信息，永不上传）
.env
.env.local
.env.*.local

# 凭证与私钥文件（各种云服务、服务器登录用，一旦上传等于把钥匙给出去）
credentials.json
serviceAccount.json
*credentials*.json
*.pem
*.key
*.p12
id_rsa
id_rsa.pub
.npmrc

# 依赖包目录（体积巨大，且可用 npm install 重建，不需要上传）
node_modules/

# 编辑器与系统自动生成的文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志文件
*.log
npm-debug.log*

# 构建产物
dist/
build/

# ── 云开发（CloudBase）相关 ──
# 注意区分两类东西：配置（含环境 ID，不算密钥，可以传）
#                  vs 凭证（真钥匙，绝对不能传）

# 凭证类：CloudBase CLI 登录后会写这里，里面有登录票据。
# 一旦上传等于把环境钥匙给出去 —— 跟上面的 *.pem / id_rsa 是同一类东西。
.cloudbase/

# 配置类：CLI 生成的配置文件（只有环境 ID 之类的信息，不含密钥）。
# 环境 ID 本身不敏感（PRD 里就记着），但它不参与运行、也不影响别人读代码，
# 所以同样不上传，保持仓库干净。
.cloudbaserc.json
